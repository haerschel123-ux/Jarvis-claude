# JARVIS development configuration (Spec §8, §62).
# Copy to .env for local development. In the packaged desktop app, secrets are stored
# in the OS credential store instead (Windows Credential Manager via keyring).
# NEVER commit a filled-in .env.

# --- Cloud LLM provider ---------------------------------------------------
# Get a key at https://openrouter.ai/keys  (free tier available)
OPENROUTER_API_KEY=

# --- Local LLM provider ---------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Optional generic OpenAI-compatible endpoint --------------------------
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=

# --- Server ---------------------------------------------------------------
# Default is loopback only. Remote/mobile access must be enabled explicitly
# in Settings, which also turns on device pairing (Spec §92).
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# --- Integrations (all optional) ------------------------------------------
GITHUB_TOKEN=
DISCORD_BOT_TOKEN=
NITRADO_TOKEN=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# --- Development ----------------------------------------------------------
JARVIS_DEBUG=0
